<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AITokenUsageWidget.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:AITokenUsageWidget.App.Controls">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（对齐 macOS 工具栏：标题 + 右上角「刷新小组件」） -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0">
            <TextBlock Text="AI 模型用量" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="12" FontWeight="SemiBold" />
            <Button x:Name="RefreshButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="8,3" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="刷新小组件" Click="OnRefreshWidgets">
                <FontIcon Glyph="&#xE72C;" FontSize="12" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧栏（对齐 macOS sidebar：供应商 / 外观 / 通知 三个分区 + 底部状态栏） -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12,8" Spacing="2">
                        <TextBlock Text="概览" Style="{StaticResource SectionHeaderText}"
                                   Margin="8,4,0,4" />
                        <ListView x:Name="DashboardList" SelectionMode="Single"
                                  Background="Transparent" BorderThickness="0" Padding="0"
                                  SelectionChanged="OnDashboardSelected">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="46">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="8"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <FontIcon Glyph="&#xE246;" FontSize="13" Foreground="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                    VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="仪表盘" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="全部用量" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Text="供应商" Style="{StaticResource SectionHeaderText}"
                                   Margin="8,10,0,4" />
                        <ListView x:Name="ProviderList" SelectionMode="Single"
                                  Background="Transparent" BorderThickness="0" Padding="0"
                                  SelectionChanged="OnProviderSelected">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="46">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:ProviderChip ChipSize="28" IconSize="13"
                                                               Kind="{Binding Kind}"
                                                               VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                    VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontSize="14"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                       Foreground="{Binding SubtitleBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Ellipse Grid.Column="2" Width="7" Height="7" Fill="#FF34C759"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding DotVisibility}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Text="外观" Style="{StaticResource SectionHeaderText}"
                                   Margin="8,14,0,4" />
                        <muxc:RadioButtons x:Name="ThemeOptions" MaxColumns="3"
                                           SelectionChanged="OnThemeChanged" />
                        <TextBlock Text="同时作用于主界面与小组件" Style="{StaticResource HintText}"
                                   Margin="8,2,0,0" />

                        <TextBlock Text="通知" Style="{StaticResource SectionHeaderText}"
                                   Margin="8,14,0,4" />
                        <ToggleSwitch x:Name="AlertsToggle" Header="用量超阈值时通知"
                                      Toggled="OnAlertsToggled" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <TextBlock Text="通知阈值" Style="{StaticResource FieldLabelText}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="ThresholdBox" MinWidth="92"
                                      SelectionChanged="OnThresholdChanged" />
                        </StackPanel>
                        <TextBlock Text="任一额度窗口用量达到阈值时发送系统通知"
                                   Style="{StaticResource HintText}" Margin="8,2,0,8" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部状态栏（对齐 macOS「n/3 已启用」） -->
                <Border Grid.Row="1" Padding="16,8"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                    <TextBlock x:Name="EnabledSummary" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>

            <!-- 内容区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <muxc:InfoBar x:Name="CorruptInfoBar" Grid.Row="0" Severity="Warning" IsOpen="False"
                              Title="配置文件已损坏" />
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </Grid>

        <!-- 「小组件已刷新」胶囊提示（对齐 macOS 底部 Toast，2 秒自动消失） -->
        <Border x:Name="RefreshToast" Grid.RowSpan="2" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                CornerRadius="16" Padding="12,6"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="#5934C759" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#FF34C759" />
                <TextBlock Text="小组件已刷新" FontSize="12" FontWeight="Medium" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
