<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AITokenUsageWidget.App.Controls.ProviderChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 品牌图标（对齐 macOS ProviderChip）：30% 圆角渐变底 + 白色矢量图标。
         Viewbox + Path 按 24×24 视口等比缩放到 IconSize；
         不用 PathIcon——它不缩放固定坐标的 Data，小尺寸下会被裁切残缺。 -->
    <Border x:Name="Root">
        <Grid>
            <!-- drop.fill（DeepSeek） -->
            <Viewbox x:Name="DropIcon" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Width="24" Height="24" Fill="White"
                      Data="M12 2.6 C12 2.6 4.6 10.6 4.6 15.1 C4.6 19.2 7.9 22.6 12 22.6 C16.1 22.6 19.4 19.2 19.4 15.1 C19.4 10.6 12 2.6 12 2.6 Z" />
            </Viewbox>
            <!-- moon.stars.fill（Kimi） -->
            <Viewbox x:Name="MoonIcon" Visibility="Collapsed"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Width="24" Height="24" Fill="White"
                      Data="M20.5 14.3 C18.2 20.2 10.8 22.4 5.8 17.6 C2.6 14.4 2.6 9.4 5.6 6.2 C7.8 3.9 11 3 13.6 3.6 C12 4.9 11.1 6.8 11.1 9.2 C11.1 14.2 15 18 20.5 14.3 Z M17.6 2.2 L18.3 4 L20.1 4.7 L18.3 5.4 L17.6 7.2 L16.9 5.4 L15.1 4.7 L16.9 4 Z" />
            </Viewbox>
            <!-- sparkles（GLM） -->
            <Viewbox x:Name="SparkleIcon" Visibility="Collapsed"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Width="24" Height="24" Fill="White"
                      Data="M10.2 3 L12.1 8.6 L17.7 10.5 L12.1 12.4 L10.2 18 L8.3 12.4 L2.7 10.5 L8.3 8.6 Z M17.8 14.6 L18.7 17.2 L21.3 18.1 L18.7 19 L17.8 21.6 L16.9 19 L14.3 18.1 L16.9 17.2 Z" />
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
