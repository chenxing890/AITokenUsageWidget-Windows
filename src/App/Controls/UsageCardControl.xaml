<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AITokenUsageWidget.App.Controls.UsageCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AITokenUsageWidget.App.Controls">

    <!-- 供应商卡片（对齐 macOS ProviderCardView）：品牌色渐变条 + 品牌图标 + 名称 + 状态点 + 主体 -->
    <Border x:Name="CardRoot" CornerRadius="12" Padding="10"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 品牌色条（纵向渐变） -->
            <Border x:Name="BrandBar" CornerRadius="1.5" Width="3" HorizontalAlignment="Left" />

            <StackPanel x:Name="ContentPanel" Grid.Column="1" Spacing="7">
                <!-- 头部：图标 + 名称 + 状态点 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:ProviderChip x:Name="Chip" ChipSize="19" IconSize="10" />
                    <TextBlock x:Name="NameText" Grid.Column="1" Margin="6,0,0,0"
                               VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <Ellipse x:Name="StatusDot" Grid.Column="2" Width="5" Height="5"
                             VerticalAlignment="Center" />
                </Grid>

                <!-- 主体（余额 / 窗口 / 错误）由代码生成 -->
                <StackPanel x:Name="BodyPanel" Spacing="6" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
