<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AITokenUsageWidget.App.Controls.UsageCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 供应商卡片（对齐 macOS ProviderCardView）：品牌色条 + 品牌图标 + 名称 + 状态点 + 主体 -->
    <Border x:Name="CardRoot" CornerRadius="12" Padding="10"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 品牌色条 -->
            <Border x:Name="BrandBar" CornerRadius="2" Width="3" HorizontalAlignment="Left" />

            <StackPanel x:Name="ContentPanel" Grid.Column="1" Spacing="7">
                <!-- 头部：图标 + 名称 + 状态点 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Chip" CornerRadius="5" Width="19" Height="19">
                        <FontIcon x:Name="ChipIcon" FontSize="10" Foreground="White" />
                    </Border>
                    <TextBlock x:Name="NameText" Grid.Column="1" Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <Ellipse x:Name="StatusDot" Grid.Column="2" Width="5" Height="5"
                             VerticalAlignment="Center" />
                </Grid>

                <!-- 主体（余额 / 窗口 / 错误）由代码生成 -->
                <StackPanel x:Name="BodyPanel" Spacing="6" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
