<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AITokenUsageWidget.App.Pages.ProviderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:AITokenUsageWidget.App.Controls">

    <ScrollViewer Padding="24,16,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">

            <!-- 头部 -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon x:Name="HeaderIcon" FontSize="22" />
                <StackPanel>
                    <TextBlock x:Name="HeaderTitle" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="HeaderSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <muxc:InfoBar x:Name="TestInfoBar" IsOpen="False" IsClosable="True" />

            <!-- 配置卡片 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch x:Name="EnableToggle" Header="启用此供应商"
                                      OnContent="启用" OffContent="停用"
                                      Toggled="OnEnableToggled" />
                        <muxc:InfoBadge x:Name="EnabledBadge" Visibility="Collapsed" VerticalAlignment="Bottom" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="API Key" />
                        <PasswordBox x:Name="ApiKeyBox" PasswordRevealMode="Peek"
                                     PlaceholderText="sk-..."
                                     PasswordChanged="OnApiKeyChanged" />
                        <TextBlock x:Name="ApiKeyHint" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- kimi-auth Cookie（仅 Kimi 显示） -->
                    <StackPanel x:Name="CookieSection" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="kimi-auth Cookie（可选，用于月度总额，非官方接口）" />
                        <PasswordBox x:Name="CookieBox" PasswordRevealMode="Peek"
                                     PlaceholderText="kimi-auth=..."
                                     PasswordChanged="OnCookieChanged" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="自定义显示名（留空用默认）" />
                            <TextBox x:Name="NameBox" PlaceholderText="默认显示名"
                                     TextChanged="OnNameChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="接口根地址（留空用默认）" />
                            <TextBox x:Name="BaseURLBox" PlaceholderText="https://..."
                                     TextChanged="OnBaseURLChanged" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="TestingRing" IsActive="False" Width="20" Height="20"
                                      Visibility="Collapsed" />
                        <Button x:Name="TestButton" Content="测试连接" Style="{StaticResource AccentButtonStyle}"
                                Click="OnTestConnection" />
                        <Button Content="打开控制台" Click="OnOpenConsole" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 内嵌预览（FR-3）：实时渲染小组件卡片 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="小组件预览" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <!-- 模拟数据角标：橙色胶囊（§3.4） -->
                        <Border x:Name="SimulatedBadge" Grid.Column="1" Visibility="Collapsed"
                                Background="#F97316" CornerRadius="8" Padding="8,2">
                            <TextBlock Text="模拟" FontSize="11" Foreground="White" />
                        </Border>
                    </Grid>
                    <controls:UsageCardControl x:Name="PreviewCard" />
                    <TextBlock x:Name="PreviewCaption" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
