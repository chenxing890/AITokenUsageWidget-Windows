<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AITokenUsageWidget.App.Pages.ProviderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:AITokenUsageWidget.App.Controls">

    <ScrollViewer Padding="24,16,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="620" HorizontalAlignment="Left">

            <!-- 头部（对齐 macOS ProviderDetailColumn）：大图标 + 名称 + 副标题 + 右侧启用开关 -->
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <controls:ProviderChip x:Name="HeaderChip" ChipSize="46" IconSize="21" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="HeaderTitle" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="HeaderSubtitle" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <ToggleSwitch x:Name="EnableToggle" Header="" OnContent="" OffContent=""
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Toggled="OnEnableToggled" />
            </Grid>

            <!-- 未启用提示（对齐 macOS「未启用」GroupCard） -->
            <Border x:Name="DisabledCard" Style="{StaticResource GroupCard}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="未启用" Style="{StaticResource GroupCardHeaderText}" />
                    </StackPanel>
                    <TextBlock x:Name="DisabledHint" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 接口配置（对齐 macOS GroupCard：内置地址提示 + API Key + 显示名 + Kimi Cookie） -->
            <Border x:Name="ConfigCard" Style="{StaticResource GroupCard}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE753;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="接口配置" Style="{StaticResource GroupCardHeaderText}" />
                    </StackPanel>

                    <TextBlock x:Name="BuiltInUrlHint" Style="{StaticResource HintText}"
                               IsTextSelectionEnabled="True" />

                    <StackPanel Spacing="5">
                        <TextBlock x:Name="ApiKeyLabel" Style="{StaticResource FieldLabelText}" />
                        <PasswordBox x:Name="ApiKeyBox" PasswordRevealMode="Peek"
                                     PlaceholderText="sk-..."
                                     PasswordChanged="OnApiKeyChanged" />
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock x:Name="NameLabel" Style="{StaticResource FieldLabelText}" />
                        <TextBox x:Name="NameBox" TextChanged="OnNameChanged" />
                    </StackPanel>

                    <!-- kimi-auth Cookie（仅 Kimi 显示） -->
                    <StackPanel x:Name="CookieSection" Spacing="5" Visibility="Collapsed">
                        <TextBlock Text="kimi-auth Cookie（可选 · 用于月度总用量）"
                                   Style="{StaticResource FieldLabelText}" />
                        <PasswordBox x:Name="CookieBox" PasswordRevealMode="Peek"
                                     PlaceholderText="kimi-auth=..."
                                     PasswordChanged="OnCookieChanged" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="浏览器登录 kimi.com → 开发者工具 → Application → Cookies 中复制；非官方接口，留空则不显示月度总额。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 连接测试（对齐 macOS GroupCard：品牌色测试按钮 + 打开控制台 + 行内结果） -->
            <Border x:Name="TestCard" Style="{StaticResource GroupCard}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE701;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="连接测试" Style="{StaticResource GroupCardHeaderText}" />
                    </StackPanel>

                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="TestButton" Content="测试连接"
                                    Click="OnTestConnection" />
                            <ProgressRing x:Name="TestingRing" IsActive="False" Width="20" Height="20"
                                          Visibility="Collapsed" VerticalAlignment="Center" />
                        </StackPanel>
                        <HyperlinkButton x:Name="ConsoleLink" Content="打开控制台"
                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Click="OnOpenConsole" />
                    </Grid>

                    <!-- 测试结果（行内：成功绿勾 / 缺 Key 橙钥匙 / 失败红叉） -->
                    <StackPanel x:Name="TestResultPanel" Orientation="Horizontal" Spacing="8"
                                Visibility="Collapsed">
                        <FontIcon x:Name="TestResultIcon" FontSize="14" />
                        <TextBlock x:Name="TestResultText" FontSize="14" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 小组件预览（对齐 macOS GroupCard：实时渲染卡片 + 「模拟」角标） -->
            <Border Style="{StaticResource GroupCard}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xECA5;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="小组件预览" Style="{StaticResource GroupCardHeaderText}" />
                    </StackPanel>

                    <Grid>
                        <controls:UsageCardControl x:Name="PreviewCard" />
                        <!-- 模拟数据角标：橙色胶囊（§3.4），叠在卡片右上角 -->
                        <Border x:Name="SimulatedBadge" Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                Background="{ThemeResource SimulatedBadgeBrush}"
                                CornerRadius="8" Padding="7,3">
                            <TextBlock Text="模拟" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" />
                        </Border>
                    </Grid>

                    <TextBlock x:Name="PreviewCaption" Style="{StaticResource HintText}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
