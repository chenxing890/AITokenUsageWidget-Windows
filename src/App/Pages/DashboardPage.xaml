<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AITokenUsageWidget.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:AITokenUsageWidget.App.Controls">

    <ScrollViewer Padding="24,16,24,24" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="12" MaxWidth="620">

            <!-- 头部：标题 + 说明 + 刷新按钮 -->
            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock Text="仪表盘" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="聚合全部已启用供应商的用量（与小组件内容一致）" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="RefreshButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="10,6" Click="OnRefresh">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="刷新" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 加载指示 -->
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="28" Height="28"
                          Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,12" />

            <!-- 卡片容器：每已启用供应商一行（大尺寸三行布局，同 Widget large） -->
            <StackPanel x:Name="CardsPanel" Spacing="12" />

            <TextBlock x:Name="CaptionText" Style="{StaticResource HintText}" Margin="2,4,0,0" />

        </StackPanel>
    </ScrollViewer>
</Page>
