<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AITokenUsageWidget.App.Pages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="通知" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="14">
                    <TextBlock Text="用量告警" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <ToggleSwitch x:Name="AlertsToggle" Header="达到阈值时发送系统通知"
                                  OnContent="开" OffContent="关"
                                  Toggled="OnAlertsToggled" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="告警阈值" />
                        <ComboBox x:Name="ThresholdBox" MinWidth="140"
                                  SelectionChanged="OnThresholdChanged" />
                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Text="同一「供应商-窗口」越过阈值期间只通知一次；回落到阈值以下 10% 后重置，额度周期重置后可再次提醒。修改阈值会清空已通知记录并立即重评估。" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
