<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AITokenUsageWidget.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="关于" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="VersionText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="DeepSeek 余额与 Kimi / GLM 的 5 小时、7 天及总用量小组件。数据仅通过 HTTPS 直连对应供应商官方接口，无遥测、无统计。" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="打开数据目录" Click="OnOpenDataDir" />
                        <Button Content="固定小组件" Click="OnShowPinTip" />
                        <HyperlinkButton Content="macOS 版仓库" NavigateUri="https://github.com/chenxing890/AITokenUsageWidget" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8">
                    <TextBlock Text="如何把小组件固定到面板" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="1. 按 Win + W 打开小组件面板&#x0a;2. 点击头像旁的「+」添加小组件&#x0a;3. 找到「AI 模型用量」并点击「+」固定&#x0a;&#x0a;Windows 不允许应用自动固定小组件，需手动添加一次。" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="PinTipBar" IsOpen="False" Severity="Informational"
                     Title="固定小组件" Message="按 Win + W 打开小组件面板 → 添加小组件 → 选择「AI 模型用量」。" />
        </StackPanel>
    </ScrollViewer>
</Page>
