<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AITokenUsageWidget.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 品牌色（§3.1，与 macOS 版一致；深色档提亮保证对比度） -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrandDeepSeek" Color="#3B82F5" />
                    <SolidColorBrush x:Key="BrandKimi" Color="#8C5CF5" />
                    <SolidColorBrush x:Key="BrandGlm" Color="#059E87" />
                    <SolidColorBrush x:Key="SimulatedBadgeBrush" Color="#F97316" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrandDeepSeek" Color="#60A5FA" />
                    <SolidColorBrush x:Key="BrandKimi" Color="#A78BFA" />
                    <SolidColorBrush x:Key="BrandGlm" Color="#34D399" />
                    <SolidColorBrush x:Key="SimulatedBadgeBrush" Color="#FB923C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 分组卡片（对齐 macOS GroupCard：12 圆角 + 4% 主色填充 + 8% 描边 + 16 内边距） -->
            <Style x:Key="GroupCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- 分组卡片标题（对齐 macOS .headline） -->
            <Style x:Key="GroupCardHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- 侧栏分区标题（对齐 macOS sidebar section：caption semibold secondary） -->
            <Style x:Key="SectionHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- 字段标签（对齐 macOS Field 标签：caption + secondary） -->
            <Style x:Key="FieldLabelText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- 辅助说明（对齐 macOS .caption2 + .tertiary） -->
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
